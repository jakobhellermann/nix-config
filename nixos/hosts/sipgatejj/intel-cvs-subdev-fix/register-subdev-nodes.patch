--- a/v4l2.c
+++ b/v4l2.c
@@ -13,6 +13,7 @@
 #include <media/v4l2-async.h>
 #include <media/v4l2-common.h>
 #include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
 #include <media/v4l2-event.h>
 #include <media/v4l2-fwnode.h>
 #include <media/v4l2-mc.h>
@@ -400,7 +401,7 @@
 				struct v4l2_async_connection *asc)
 {
 	struct icvs *ctx = notifier_to_csi(notifier);
-	int pad;
+	int pad, ret;
 
 	pad = media_entity_get_fwnode_pad(&sd->entity, asc->match.fwnode,
 					  MEDIA_PAD_FL_SOURCE);
@@ -409,9 +410,22 @@
 
 	ctx->remote = &sd->entity.pads[pad];
 
-	return media_create_pad_link(&sd->entity, pad, &ctx->subdev.entity,
+	ret = media_create_pad_link(&sd->entity, pad, &ctx->subdev.entity,
 				     ICVS_CSI_PAD_SINK, MEDIA_LNK_FL_ENABLED |
 				     MEDIA_LNK_FL_IMMUTABLE);
+	if (ret)
+		return ret;
+
+	/*
+	 * The async core has registered @sd to the root v4l2_device by the time
+	 * this callback runs, but nothing creates its /dev/v4l-subdev* node:
+	 * notifier completion never happens while another sensor in the same
+	 * firmware graph has no driver (the root notifier's waiting list stays
+	 * non-empty), and the ipu7 isys driver only registers subdev nodes from
+	 * its own notifier callbacks. Register them here so a bound sensor is
+	 * usable regardless of whether the rest of the graph ever completes.
+	 */
+	return v4l2_device_register_subdev_nodes(sd->v4l2_dev);
 }
 
